#!/bin/bash
# lid-awake setup: copies the runtime files into ~/.lid-awake, installs the
# SwiftBar plugin, and loads the background guard. Safe to re-run.
# Usage: lid-awake-setup [--dry-run]
set -e

DEFAULT_SRC="$(cd "$(dirname "$0")" && pwd)"
SRC="${LID_AWAKE_SRC:-$DEFAULT_SRC}"
DEST="$HOME/.lid-awake"
PLIST="$HOME/Library/LaunchAgents/org.lidawake.guard.plist"

DRY=0
[ "$1" = "--dry-run" ] && DRY=1

run() {
  if [ "$DRY" = 1 ]; then echo "[dry-run] $*"; else "$@"; fi
}

for f in lid-toggle.sh lid-battery-guard.sh lid-settings.sh lidawake.10s.sh thermalstate; do
  if [ ! -f "$SRC/$f" ]; then
    echo "ERROR: $SRC/$f not found. Set LID_AWAKE_SRC to the folder holding the lid-awake files." >&2
    exit 1
  fi
done

PLUGDIR=$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null || true)
if [ -z "$PLUGDIR" ]; then
  echo "SwiftBar is not configured yet. Install it (brew install --cask swiftbar),"
  echo "launch it once, pick a plugin folder, then re-run lid-awake-setup."
  exit 1
fi

run mkdir -p "$DEST/state"
run cp "$SRC/lid-toggle.sh" "$SRC/lid-battery-guard.sh" "$SRC/lid-settings.sh" "$SRC/thermalstate" "$DEST/"
run chmod +x "$DEST/lid-toggle.sh" "$DEST/lid-battery-guard.sh" "$DEST/lid-settings.sh" "$DEST/thermalstate"
# strip macOS download-quarantine so the thermal helper can run, then verify it does
run xattr -dr com.apple.quarantine "$DEST" 2>/dev/null || true
if [ "$DRY" = 1 ]; then
  TS=$("$SRC/thermalstate" 2>/dev/null || true)
else
  TS=$("$DEST/thermalstate" 2>/dev/null || true)
fi
case "$TS" in
  0|1|2|3) echo "Thermal helper OK (thermalState=$TS)." ;;
  *) echo "WARNING: the thermal helper did not run (Gatekeeper may be blocking it). Thermal auto-sleep will stay INACTIVE until this is resolved; the rest of lid-awake works normally." ;;
esac

run cp "$SRC/lidawake.10s.sh" "$PLUGDIR/"
run chmod +x "$PLUGDIR/lidawake.10s.sh"

run mkdir -p "$HOME/Library/LaunchAgents"
if [ "$DRY" = 1 ]; then
  echo "[dry-run] write LaunchAgent $PLIST (runs $DEST/lid-battery-guard.sh every 60s)"
else
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.lidawake.guard</string>
  <key>ProgramArguments</key><array><string>$DEST/lid-battery-guard.sh</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
</dict></plist>
EOF
fi
PMSET_OK=0
sudo -n pmset -g >/dev/null 2>&1 && PMSET_OK=1
if [ "$PMSET_OK" = 0 ]; then
  echo "NOTE: passwordless pmset is not set up yet. Add the sudoers line below FIRST, then re-run lid-awake-setup so the guard can actually control sleep."
fi
run launchctl unload "$PLIST" 2>/dev/null || true
run launchctl load "$PLIST"

echo ""
if [ "$PMSET_OK" = 1 ]; then
  echo "Installed. Passwordless pmset is already set up, so no manual step remains."
  echo "Click the moon icon in the menu bar. Done."
else
  echo "Installed. One manual step remains: passwordless pmset for the toggle."
  echo "Run:  sudo visudo -f /etc/sudoers.d/lid-awake"
  echo "and add the single line:"
  echo ""
  echo "  $USER ALL=(root) NOPASSWD: /usr/bin/pmset"
  echo ""
  echo "Then click the moon icon in the menu bar. Done."
fi
