#!/bin/bash
# lid-awake pkg postinstall. Runs as root after lid-awake.app lands in
# /Applications. Installs the restricted per-user sudoers rule (README
# "Permission" section) for the console user, then opens the app in their
# session. Everything else — safety LaunchAgent, login item, v1 cleanup —
# is done by the app itself on first launch.
# A rule left by the v1 installer at the same path (broader: all of pmset
# for %admin) is replaced by this restricted one.
# Test hooks: LIDAWAKE_DESTDIR prefixes all write paths, LIDAWAKE_DRYRUN=1
# prints actions instead of doing them.
set -e

D="${LIDAWAKE_DESTDIR:-}"
DRY="${LIDAWAKE_DRYRUN:-0}"

run() {
  if [ "$DRY" = 1 ]; then echo "[dry-run] $*"; else "$@"; fi
}

CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
case "$CONSOLE_USER" in
  ""|root|loginwindow|_mbsetupuser)
    echo "No console user detected. Add the sudoers rule from the README"
    echo "(Permission section), then open /Applications/lid-awake.app."
    exit 0 ;;
esac

# Only the five pmset command forms the app uses, only for this user.
# Must stay in sync with sudoersLine in native/Sources/LidAwakeApp.swift.
RULE="$CONSOLE_USER ALL=(root) NOPASSWD: /usr/bin/pmset -a disablesleep 0, /usr/bin/pmset -a disablesleep 1, /usr/bin/pmset -b lowpowermode 0, /usr/bin/pmset -b lowpowermode 1, /usr/bin/pmset sleepnow"
SUDOERS="$D/etc/sudoers.d/lid-awake"
TMP="$(mktemp)"
printf '%s\n' "$RULE" > "$TMP"
if visudo -cf "$TMP" >/dev/null 2>&1; then
  run install -m 0440 -o root -g wheel "$TMP" "$SUDOERS"
else
  echo "ERROR: generated sudoers rule failed visudo validation; skipping sudoers install." >&2
fi
rm -f "$TMP"

# First launch from /Applications registers the LaunchAgent and login item
# and sweeps v1 leftovers. Skipped under LIDAWAKE_DESTDIR (test install).
if [ -z "$D" ]; then
  USER_UID="$(id -u "$CONSOLE_USER")"
  run launchctl asuser "$USER_UID" sudo -u "$CONSOLE_USER" open -a "/Applications/lid-awake.app" || true
fi

exit 0
