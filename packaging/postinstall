#!/bin/bash
# LidAwake pkg postinstall. Runs as root after LidAwake.app lands in
# /Applications. Installs the restricted sudoers rule and deletes the old
# v2 bundle (lid-awake.app is a different APFS entry from LidAwake.app).
# The app itself sweeps v1 remnants by enumeration on every launch.
# Test hooks: LIDAWAKE_DESTDIR prefixes all write paths, LIDAWAKE_DRYRUN=1
# prints actions instead of doing them.
set -e

D="${LIDAWAKE_DESTDIR:-}"
DRY="${LIDAWAKE_DRYRUN:-0}"

run() {
  if [ "$DRY" = 1 ]; then echo "[dry-run] $*"; else "$@"; fi
}

# 1. The old v2 bundle must not survive next to the renamed one — and a
# RUNNING v2 must die first, or it keeps fighting the new app over pmset
# from a deleted bundle. pkill exits 1 when nothing matched; that is fine.
run pkill -f '/Applications/lid-awake.app/Contents/MacOS/' || true
if [ -d "$D/Applications/lid-awake.app" ]; then
  run rm -rf "$D/Applications/lid-awake.app"
fi

# 2. Passwordless pmset for every admin user, restricted to the five
# command forms the app uses. Validate before installing; never break sudo.
# The retired hyphenated sudoers file from earlier installs goes away.
if [ -f "$D/etc/sudoers.d/lid-awake" ]; then
  run rm -f "$D/etc/sudoers.d/lid-awake"
fi
SUDOERS="$D/etc/sudoers.d/lidawake"
TMP="$(mktemp)"
echo "%admin ALL=(root) NOPASSWD: /usr/bin/pmset -a disablesleep 0, /usr/bin/pmset -a disablesleep 1, /usr/bin/pmset -b lowpowermode 0, /usr/bin/pmset -b lowpowermode 1, /usr/bin/pmset sleepnow" > "$TMP"
if visudo -cf "$TMP" >/dev/null 2>&1; then
  run install -m 0440 -o root -g wheel "$TMP" "$SUDOERS"
else
  echo "ERROR: generated sudoers rule failed visudo validation; skipping sudoers install." >&2
fi
rm -f "$TMP"

# 3. Open the app for the console user so it can install its watchdog
# LaunchAgent and finish the v1/v2 migration in their session.
CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
case "$CONSOLE_USER" in
  ""|root|loginwindow|_mbsetupuser)
    echo "No console user detected. Log in and open /Applications/LidAwake.app once."
    exit 0 ;;
esac
USER_UID="$(id -u "$CONSOLE_USER")"
run launchctl asuser "$USER_UID" sudo -u "$CONSOLE_USER" open "$D/Applications/LidAwake.app" || true

exit 0
